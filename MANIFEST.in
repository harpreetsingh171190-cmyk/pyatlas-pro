include LICENSE LICENSE-CONTENT.md NOTICE.md README.md CHANGELOG.md SECURITY.md pyproject.toml
include package.json package-lock.json Dockerfile mkdocs.yml lighthouserc.cjs Makefile
recursive-include pyatlas *.py *.typed *.json *.html *.css *.js *.png *.webmanifest *.txt
recursive-include tests *.py *.cjs
recursive-include tools *.py
recursive-include docs *.md *.png *.css
recursive-include .github *.yml *.md
prune node_modules
prune site-docs
prune reports
prune wheelhouse
prune release-dist
prune build
global-exclude __pycache__ *.pyc
